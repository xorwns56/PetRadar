# 이 파일을 .env로 복사해서 실제 값을 채운다 (.env는 git에 올리지 않는다)
#
#   cp .env.example .env
#
# 배포 서버에서는 손으로 만들지 않는다 — init.sh가 생성한다
#
# JWT 서명 키는 32바이트 이상이어야 한다. 아래 명령으로 만들 수 있다.
#   openssl rand -base64 48

MYSQL_ROOT_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-bytes

# HTTPS를 적용한 뒤 true로 바꾼다. HTTP 환경에서 true면 쿠키가 전송되지 않아 로그인이 풀린다
COOKIE_SECURE=false

# 공공데이터포털(data.go.kr) 인증키 — 보호소·유기동물 정보를 받아온다.
# 계정당 인증키는 하나이고, 아래 두 API에 각각 활용신청(자동승인)하면 같은 키로 둘 다 쓴다.
#   전국동물보호센터정보표준데이터        https://www.data.go.kr/data/15025454/standard.do
#   국가동물보호정보시스템 구조동물 조회  https://www.data.go.kr/data/15098931/openapi.do
# 마이페이지 > 데이터활용 > Open API > 인증키 발급현황에서 확인한다.
# 키가 두 종류로 나오는데 반드시 "일반 인증키(Decoding)" 쪽을 넣는다.
# Encoding 키를 넣으면 이중 인코딩이 되어 SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 난다
DATA_GO_KR_SERVICE_KEY=change-me
