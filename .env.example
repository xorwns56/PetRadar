# 이 파일을 .env로 복사해서 실제 값을 채운다 (.env는 git에 올리지 않는다)
#
#   cp .env.example .env
#
# JWT 서명 키는 32바이트 이상이어야 한다. 아래 명령으로 만들 수 있다.
#   openssl rand -base64 48

MYSQL_ROOT_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-bytes

# HTTPS를 적용한 뒤 true로 바꾼다. HTTP 환경에서 true면 쿠키가 전송되지 않아 로그인이 풀린다
COOKIE_SECURE=false
