# =============================================================
# 로컬 개발용 백엔드 이미지
#
# 운영용 Dockerfile과 목적이 다르다.
#   운영 — 빌드된 JAR만 담은 경량 JRE 이미지
#   개발 — 소스를 마운트해 컨테이너 안에서 다시 빌드·재시작
#
# 소스는 docker-compose.dev.yml에서 볼륨으로 넣어 준다.
# 이미지에 COPY 하지 않으므로 코드를 고칠 때 이미지를 다시 만들 필요가 없다.
# =============================================================
FROM eclipse-temurin:17-jdk
WORKDIR /app

# 래퍼와 빌드 스크립트만 넣는다. 소스는 볼륨으로 들어온다
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./
RUN chmod +x ./gradlew

# 의존성을 여기서 미리 받지 않는다.
# 런타임에 gradle-cache 볼륨이 /root/.gradle을 덮어써서, 빌드 때 받아둔 것이
# 가려져 어차피 다시 받게 된다. 첫 기동에서 한 번 받아 볼륨에 남기는 편이 낫다

EXPOSE 8080
# 원격 디버그. IDE에서 Remote JVM Debug로 붙는다
EXPOSE 5005

# 핫 리로드는 두 프로세스가 나눠 맡는다.
#   classes --continuous : 소스가 바뀌면 build/classes에 다시 컴파일한다
#   bootRun              : devtools가 build/classes 변화를 감지해 애플리케이션을 재시작한다
#
# bootRun 하나에 --continuous를 붙이면 동작하지 않는다. Gradle의 연속 빌드는
# 태스크가 끝나야 다시 도는데 bootRun은 끝나지 않기 때문이다.
CMD ["sh", "-c", "./gradlew classes --continuous -q & ./gradlew bootRun"]
