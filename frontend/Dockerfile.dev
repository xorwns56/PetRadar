# =============================================================
# 로컬 개발용 프론트엔드 이미지
#
# 소스는 docker-compose.dev.yml에서 볼륨으로 넣어 준다.
# 이미지에 COPY 하지 않으므로 코드를 고칠 때 이미지를 다시 만들 필요가 없다.
# =============================================================
FROM node:20-alpine
WORKDIR /app

# 의존성만 먼저 설치해 레이어로 굳혀 둔다. package.json이 바뀔 때만 다시 받는다
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev"]
